T{
\f[CR]basename\f[R]
T}@T{
Strips directory prefix and optional suffix
(\f[CR]\-a\f[R]/\f[CR]\-\-multiple\f[R],
\f[CR]\-s\f[R]/\f[CR]\-\-suffix\f[R] implies \f[CR]\-a\f[R],
\f[CR]\-z\f[R]/\f[CR]\-\-zero\f[R] NUL terminator)[cite: 4].
T}
T{
\f[CR]bc\f[R]
T}@T{
Arbitrary\-precision calculator language (\f[CR]\-l\f[R] loads math
library \f[CR]s\f[R], \f[CR]c\f[R], \f[CR]a\f[R], \f[CR]l\f[R],
\f[CR]e\f[R] with \f[CR]scale=20\f[R]; \f[CR]\-q\f[R] quiet; division by
zero exits status \f[CR]1\f[R])[cite: 4].
T}
T{
\f[CR]cal\f[R]
T}@T{
Prints Gregorian calendar (\f[CR]\-a\f[R]/\f[CR]\-\-today\f[R] starts
