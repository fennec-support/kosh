T{
\f[CR]calc\f[R]
T}@T{
Evaluates arbitrary\-precision integer and finite decimal expressions
from operands, \f[CR]\-i\f[R] (\f[CR]\-\-interactive\f[R] with
\f[CR]Ctrl\-R\f[R] history), or \f[CR]\-p\f[R]
(\f[CR]\-\-pipe\f[R])[cite: 4].
Builtin functions: \f[CR]abs\f[R], \f[CR]atan\f[R], \f[CR]ceil\f[R],
\f[CR]cmp\f[R], \f[CR]cos\f[R], \f[CR]exp\f[R], \f[CR]fact\f[R],
\f[CR]fib\f[R], \f[CR]floor\f[R], \f[CR]frac\f[R], \f[CR]gcd\f[R],
\f[CR]int\f[R], \f[CR]iseven\f[R], \f[CR]isint\f[R], \f[CR]isodd\f[R],
\f[CR]length\f[R], \f[CR]lcm\f[R], \f[CR]ln\f[R], \f[CR]max\f[R],
\f[CR]min\f[R], \f[CR]scale\f[R], \f[CR]sgn\f[R], \f[CR]sin\f[R],
\f[CR]sqrt\f[R][cite: 4].
T}
T{
\f[CR]evil\f[R]
T}@T{
Prints system identity, uptime, CPU, memory, swap, filesystem, process,
and network summary (\f[CR]\-a\f[R] detailed, \f[CR]\-s\f[R] select
identity fields, \f[CR]\-u\f[R] local users)[cite: 4].
T}
T{
\f[CR]evildisk\f[R]
T}@T{
Prints disk capacity, filesystem identity, and error/retry totals
(\f[CR]\-a\f[R] adds labels, UUIDs, error counters, and SMART telemetry;
accepts optional device/file filters)[cite: 4].
T}
T{
\f[CR]evilfiles\f[R]
T}@T{
Lists open file descriptors filtered by \f[CR]\-p\f[R] (PID),
\f[CR]\-u\f[R] (owner), \f[CR]\-c\f[R] (command prefix), \f[CR]\-i\f[R]
(sockets), \f[CR]\-t\f[R] (terse PIDs),
\f[CR]\-w\f[R]/\f[CR]\-\-wide\f[R] (untruncated), and optional path
operands[cite: 4].
T}
T{
\f[CR]evilfs\f[R]
T}@T{
Prints mounted filesystems[cite: 4].
T}
T{
\f[CR]evilio\f[R]
T}@T{
Prints memory, swap, and cumulative disk I/O counters (\f[CR]\-a\f[R]
samples 1s CPU/paging/scheduler/PSI/disk/swap rates;
\f[CR]\-h\f[R]/\f[CR]\-\-human\-readable\f[R] binary units;
\f[CR]\-\-ps\f[R], \f[CR]\-n\f[R], \f[CR]\-p\f[R], \f[CR]\-NUMBER\f[R]
per\-process I/O tables)[cite: 4].
Supports \f[CR]\-l\f[R]/\f[CR]\-\-live[=N]\f[R],
\f[CR]\-\-cumulative[=M]\f[R], and \f[CR]\-\-sort\f[R] (\f[CR]pid\f[R],
\f[CR]read\f[R], \f[CR]write\f[R], \f[CR]read\-ops\f[R],
\f[CR]write\-ops\f[R], \f[CR]busy\f[R], \f[CR]read\-latency\f[R],
\f[CR]write\-latency\f[R], \f[CR]average\-queue\f[R], \f[CR]queue\f[R],
\f[CR]errors\f[R], \f[CR]retries\f[R])[cite: 4].
T}
T{
\f[CR]eviliso\f[R]
T}@T{
Inspects isolation primitives: namespaces (\f[CR]\-n\f[R]), cgroups
(\f[CR]\-c\f[R]), login sessions (\f[CR]\-s\f[R]), remote sockets
(\f[CR]\-r\f[R]), container runtimes (\f[CR]\-k\f[R],
\f[CR]\-\-container\f[R]), and Kubernetes pods
(\f[CR]\-\-kubernetes\f[R], reading \f[CR]KUBERNETES_SERVICE_HOST\f[R],
service\-account namespace, and \f[CR]kubepods\f[R] cgroups), with
\f[CR]\-a\f[R] for full detail[cite: 4].
T}
T{
\f[CR]evillogs\f[R]
T}@T{
Reports core dump configuration, crash reports (\f[CR]\-\-cores\f[R]),
and system log directories (\f[CR]\-\-logs\f[R])[cite: 4].
T}
T{
\f[CR]evilnet\f[R]
T}@T{
Reports IPv4/IPv6 interface addresses (\f[CR]\-a\f[R] adds traffic,
errors, drops, and TCP counters; \f[CR]\-f\f[R] TCP failure/loss only;
\f[CR]\-t\f[R]/\f[CR]\-\-traffic\f[R] traffic table only; supports
\f[CR]\-l\f[R]/\f[CR]\-\-live[=N]\f[R], \f[CR]\-\-cumulative[=M]\f[R],
and \f[CR]\-\-sort\f[R] by \f[CR]name\f[R], \f[CR]bytes\f[R],
\f[CR]packets\f[R], \f[CR]errors\f[R], \f[CR]drops\f[R])[cite: 4].
T}
T{
\f[CR]evilps\f[R]
T}@T{
Renders process hierarchy tree (\f[CR]\-p\f[R] PIDs, \f[CR]\-n\f[R]
numeric sort, \f[CR]\-a\f[R] all fields, \f[CR]\-A\f[R] command lines,
\f[CR]\-U\f[R] owners, \f[CR]\-c\f[R] CPU, \f[CR]\-M\f[R] memory,
\f[CR]\-w\f[R]/\f[CR]\-\-wide\f[R] untruncated, \f[CR]\-NUMBER\f[R] row
limit, \f[CR]\-l\f[R]/\f[CR]\-\-live[=N]\f[R] with \f[CR]s\f[R] sort
cycle and \f[CR]/\f[R] search,
\f[CR]\-C\f[R]/\f[CR]\-\-cumulative[=M]\f[R], and \f[CR]\-\-sort\f[R] by
\f[CR]name\f[R], \f[CR]pid\f[R], \f[CR]cpu\f[R],
\f[CR]memory\f[R])[cite: 4].
T}
T{
\f[CR]evilss\f[R]
T}@T{
Lists sockets filtered by \f[CR]\-l\f[R] (listening), \f[CR]\-a\f[R]
(all), \f[CR]\-t\f[R] (TCP), \f[CR]\-u\f[R] (UDP), \f[CR]\-x\f[R]
(Unix), \f[CR]\-4\f[R], \f[CR]\-6\f[R], \f[CR]\-p\f[R] (owning process),
\f[CR]\-n\f[R] (numeric addresses), \f[CR]\-H\f[R] (no header), and
\f[CR]\-\-live\f[R][cite: 4].
T}
T{
\f[CR]goodcore\f[R]
T}@T{
Captures live process core (\f[CR]\-p PID\f[R]) or packages an existing
core and binary (\f[CR]\-b\f[R]), bundling \f[CR]dump/core\f[R], shared
libraries under \f[CR]root/\f[R], and \f[CR]debug\-gdb.sh\f[R] /
\f[CR]debug\-lldb.sh\f[R] wrappers into
\f[CR]goodcore\-<core>.tar.zst\f[R] (or \f[CR].tar.gz\f[R] /
\f[CR]\-o PATH\f[R] / \f[CR]\-\-no\-compress\f[R], \f[CR]\-q\f[R]
quiet)[cite: 4].
T}
T{
\f[CR]goodfsw\f[R]
T}@T{
Monitors path metadata changes (via \f[CR]inotify\f[R] plus 30\-period
full rescans on Linux, or periodic scans elsewhere)[cite: 4].
Supports \f[CR]\-h\f[R] (human timestamps/labels), \f[CR]\-m\f[R]
(numeric mask), \f[CR]\-\-timezone\f[R], \f[CR]\-\-precision\f[R],
\f[CR]\-r\f[R] (recursive), \f[CR]\-\-event\-flags\f[R], \f[CR]\-x\f[R]
(one filesystem), \f[CR]\-1\f[R] (single batch), \f[CR]\-l\f[R] (latency
period), and \f[CR]\-e\f[R] (exclude substring)[cite: 4].
T}
T{
\f[CR]goodnode\f[R]
T}@T{
Reports inode identity, allocation blocks, filesystem capabilities,
\f[CR]\-\-verify\f[R] native fs verification status, and CRC32C
checksums (\f[CR]\-i\f[R] locates an inode under
\f[CR]\-r PATH\f[R])[cite: 4].
T}
T{
\f[CR]goodstat\f[R]
T}@T{
Prints labeled file metadata (\f[CR]\-L\f[R] dereference symlinks,
\f[CR]\-c\f[R] include CRC32C checksum, \f[CR]\-f\f[R] filesystem
capacity report)[cite: 4].
T}
T{
\f[CR]meow\f[R]
T}@T{
Renders an animated pixel\-art cat screensaver
(\f[CR]\-f\f[R]/\f[CR]\-\-fps\f[R] \f[CR]1\f[R]..\f[CR]240\f[R], default
\f[CR]60\f[R]; \f[CR]\-s\f[R]/\f[CR]\-\-speed\f[R]
\f[CR]0.1\f[R]..\f[CR]10\f[R]; \f[CR]\-n\f[R]/\f[CR]\-\-cats\f[R]
\f[CR]1\f[R]..\f[CR]8\f[R]; \f[CR]Space\f[R] pauses,
\f[CR]+\f[R]/\f[CR]\-\f[R] adjusts speed)[cite: 4].
T}
T{
\f[CR]retry\f[R]
T}@T{
Re\-executes a failing command using \f[CR]\-n\f[R] (max attempts),
\f[CR]\-d\f[R] (initial delay), \f[CR]\-b\f[R] (backoff multiplier),
\f[CR]\-m\f[R] (max delay), and \f[CR]\-q\f[R] (quiet)[cite: 4].
T}
T{
\f[CR]slurp\f[R], \f[CR]vi\f[R], \f[CR]emacs\f[R]
T}@T{
Invokes the \f[CR]slurp\f[R] editor (\f[CR]vi\f[R] implies
\f[CR]\-V\f[R]; \f[CR]emacs\f[R] implies \f[CR]\-e\f[R])[cite: 4].
T}
.TE
