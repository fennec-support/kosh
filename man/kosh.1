T}
T{
\f[CR]cat\f[R]
T}@T{
Concatenates files (\f[CR]\-n\f[R], \f[CR]\-b\f[R], \f[CR]\-s\f[R],
\f[CR]\-v\f[R], \f[CR]\-E\f[R], \f[CR]\-T\f[R], \f[CR]\-e\f[R],
\f[CR]\-t\f[R], \f[CR]\-A\f[R], \f[CR]\-u\f[R], and
\f[CR]\-\-syntax\-highlighting\f[R] for terminal shell source)[cite: 4].
T}
T{
\f[CR]chgrp\f[R], \f[CR]chown\f[R]
