\f[CR]i\f[R], \f[CR]a\f[R], \f[CR]I\f[R], \f[CR]A\f[R], \f[CR]R\f[R],
\f[CR].\f[R]
T}@T{
Enter insert mode at cursor, after cursor, at first non\-blank, at line
end, in non\-overwriting replace mode (\f[CR]R\f[R]), or repeat the last
change other than a yank (\f[CR].\f[R]).
T}
T{
\f[CR]u\f[R], \f[CR]Ctrl\-_\f[R], \f[CR]Ctrl\-Z\f[R] /
\f[CR]Ctrl\-R\f[R], \f[CR]Ctrl\-\[ha]\f[R], \f[CR]Ctrl\-Shift\-Z\f[R]
