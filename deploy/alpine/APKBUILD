# Contributor: Alexey Andreyev <dev@aa13q.ru>
# Maintainer: Alexey Andreyev <dev@aa13q.ru>
maintainer="Alexey Andreyev <dev@aa13q.ru>"
pkgname=kosh
pkgver=0.3.0
pkgrel=0
pkgdesc="Fast, portable, Bash-compatible interactive shell, interpreter and diagnostic tool"
url="https://github.com/fennec-support/kosh"
arch="x86_64 aarch64"
license="BSD-3-Clause AND MIT"
depends="busybox"
makedepends="build-base clang llvm lld linux-headers git"
checkdepends="bash dash python3 util-linux-misc"
install="$pkgname.post-install $pkgname.post-upgrade $pkgname.pre-deinstall"
subpackages="$pkgname-doc $pkgname-bash-completion"

# Pinned to the exact commit the "src/toiletline" submodule points to for
# this release (see .gitmodules / `git submodule status`). GitHub's tarball
# for a tag does not include submodule contents, so it's fetched separately
# and dropped into place in prepare().
_release_commit="951f3550cacc4684c6e50ff41c6ea8b40a8b5232"
_release_epoch=1791053686
_source_directory="$pkgname-$pkgver"
_toiletline_commit="ee504b4823a85c30e8a6e11c9539932ed85c8282"
export SOURCE_DATE_EPOCH="$_release_epoch"

source="
  $pkgname-$pkgver.tar.gz::https://github.com/fennec-support/kosh/archive/refs/tags/$pkgver.tar.gz
  toiletline-$_toiletline_commit.tar.gz::https://github.com/toiletbril/toiletline/archive/$_toiletline_commit.tar.gz
  "
builddir="$srcdir/$_source_directory"

prepare() {
  default_prepare
  rm -rf "$builddir/src/toiletline"
  cp -r "$srcdir/toiletline-$_toiletline_commit" "$builddir/src/toiletline"
}

build() {
  make MODE=rel ENVCXXFLAGS="$CXXFLAGS $LDFLAGS" \
    COMMIT_HASH="$_release_commit" OS_INFO="Alpine Linux"
}

check() {
  make MODE=rel ENVCXXFLAGS="$CXXFLAGS $LDFLAGS" \
    COMMIT_HASH="$_release_commit" OS_INFO="Alpine Linux" BASHP=/bin/bash \
    DASH=/usr/bin/dash test
}

package() {
  install -Dm755 kosh "$pkgdir/usr/bin/kosh"
  install -Dm644 docs/kosh.1 "$pkgdir/usr/share/man/man1/kosh.1"
  install -Dm644 docs/kosh.5 "$pkgdir/usr/share/man/man5/kosh.5"
  install -Dm644 completions/kosh.bash "$pkgdir/usr/share/bash-completion/completions/kosh"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 src/toiletline/LICENSE.txt \
    "$pkgdir/usr/share/licenses/$pkgname/toiletline-LICENSE.txt"
}

sha512sums="
5215255b6483986427a97bf2c0384d6e1e8e70f88e9f79268b06fac8b57aa824f7bfd650ba22ef73cc65fd8d93f0b97ad65bd88e73d03a642ab6f9ab4a5efe0f  kosh-0.3.0.tar.gz
6d1691bec35f7e5e0e64eb8aefad6dbe575ca190f8f8dcb989551f9509c33955c4e5e7752415cceb5059358946bb711d61644502c4f413e52a2783ff7a972192  toiletline-ee504b4823a85c30e8a6e11c9539932ed85c8282.tar.gz
"
