# Contributor: Alexey Andreyev <dev@aa13q.ru>
pkgname=kosh-shell
_upstream_name=kosh
pkgver=0.3.0
pkgrel=1
pkgdesc="Fast, portable, Bash-compatible interactive shell, interpreter and diagnostic tool"
arch=('x86_64' 'aarch64')
url="https://github.com/fennec-support/kosh"
license=('BSD-3-Clause AND MIT')
depends=('glibc')
makedepends=('clang' 'git')
conflicts=('kosh')
install=kosh-shell.install
_release_commit="951f3550cacc4684c6e50ff41c6ea8b40a8b5232"
_release_epoch=1791053686
_source_directory="$_upstream_name-$pkgver"
_toiletline_commit="ee504b4823a85c30e8a6e11c9539932ed85c8282"
export SOURCE_DATE_EPOCH="$_release_epoch"
source=(
  "$_upstream_name-$pkgver.tar.gz::https://github.com/fennec-support/kosh/archive/refs/tags/$pkgver.tar.gz"
  "toiletline-$_toiletline_commit.tar.gz::https://github.com/toiletbril/toiletline/archive/$_toiletline_commit.tar.gz"
)
sha512sums=(
  '5215255b6483986427a97bf2c0384d6e1e8e70f88e9f79268b06fac8b57aa824f7bfd650ba22ef73cc65fd8d93f0b97ad65bd88e73d03a642ab6f9ab4a5efe0f'
  '6d1691bec35f7e5e0e64eb8aefad6dbe575ca190f8f8dcb989551f9509c33955c4e5e7752415cceb5059358946bb711d61644502c4f413e52a2783ff7a972192'
)

prepare() {
  rm -rf "$srcdir/$_source_directory/src/toiletline"
  cp -r "$srcdir/toiletline-$_toiletline_commit" \
    "$srcdir/$_source_directory/src/toiletline"
}

build() {
  cd "$srcdir/$_source_directory"
  # Releases up to 0.3.0 define _FORTIFY_SOURCE=2 themselves under -Werror,
  # which clashes with the makepkg level. Drop this once a release keeps it.
  local _cxxflags="${CXXFLAGS//-Wp,-D_FORTIFY_SOURCE=3/}"
  make MODE=rel ENVCXXFLAGS="$_cxxflags $LDFLAGS" \
    COMMIT_HASH="$_release_commit" OS_INFO="Arch Linux"
}

package() {
  cd "$srcdir/$_source_directory"
  install -Dm755 kosh "$pkgdir/usr/bin/kosh"
  install -Dm644 docs/kosh.1 "$pkgdir/usr/share/man/man1/kosh.1"
  install -Dm644 docs/kosh.5 "$pkgdir/usr/share/man/man5/kosh.5"
  install -Dm644 completions/kosh.bash "$pkgdir/usr/share/bash-completion/completions/kosh"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 src/toiletline/LICENSE.txt \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.toiletline"
}
