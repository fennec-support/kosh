# Contributor: Alexey Andreyev <dev@aa13q.ru>
pkgname=kosh-shell
_upstream_name=kosh
pkgver=0.4.0
pkgrel=1
pkgdesc="Fast, portable, Bash-compatible interactive shell, interpreter and diagnostic tool"
arch=('x86_64' 'aarch64')
url="https://github.com/fennec-support/kosh"
license=('BSD-3-Clause AND MIT')
depends=('glibc')
makedepends=('clang' 'git')
conflicts=('kosh')
install=kosh-shell.install
_tag=0.4.0
_release_commit="6c8b1df3194e587e387a440ed62cd8cce741903d"
_release_epoch=1793905356
_source_directory="$_upstream_name-${_tag#v}"
_toiletline_commit="d9c4ad722e8191d7abf17d6fd910ce8c27a38323"
export SOURCE_DATE_EPOCH="$_release_epoch"
source=(
  "$_upstream_name-$pkgver.tar.gz::https://github.com/fennec-support/kosh/archive/refs/tags/$_tag.tar.gz"
  "toiletline-$_toiletline_commit.tar.gz::https://github.com/toiletbril/toiletline/archive/$_toiletline_commit.tar.gz"
)
sha512sums=(
  'd81eb1ee20779c1cc67914d8723b6344126844753ddc225d89ce5538958fad2820037e88aee76f41d94d61b56340fa4327d13b24284c1206f1a5bc182b663d50'
  'ac7422832c2623e705b9093d820024e5faa8999900c85f255ce79fc49654d587f70fbbc846603e05450f5d338800977855fdd6a933efb6501c9a2122ba369121'
)

prepare() {
  rm -rf "$srcdir/$_source_directory/src/toiletline"
  cp -r "$srcdir/toiletline-$_toiletline_commit" \
    "$srcdir/$_source_directory/src/toiletline"
}

build() {
  cd "$srcdir/$_source_directory"
  make MODE=rel ENVCXXFLAGS="$CXXFLAGS $LDFLAGS" \
    COMMIT_HASH="$_release_commit" OS_INFO="Arch Linux"
}

package() {
  cd "$srcdir/$_source_directory"
  install -Dm755 kosh "$pkgdir/usr/bin/kosh"
  ln -s kosh "$pkgdir/usr/bin/koshkit"
  install -Dm644 man/kosh.1 "$pkgdir/usr/share/man/man1/kosh.1"
  install -Dm644 man/kosh.5 "$pkgdir/usr/share/man/man5/kosh.5"
  install -Dm644 man/kosh-switching.5 "$pkgdir/usr/share/man/man5/kosh-switching.5"
  install -Dm644 completions/kosh.bash "$pkgdir/usr/share/bash-completion/completions/kosh"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 src/toiletline/LICENSE.txt \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.toiletline"
}
