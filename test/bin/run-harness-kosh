#!/bin/bash

BIN_DIR=${0%/*}
read -r -a DIFF_OPTIONS <<<"$DIFF_FLAGS"
TEST_FILE=$1
TEST_NAME=${TEST_FILE##*/}
TEST_NAME=${TEST_NAME%.kosh}

case " $SKIPPED_TESTS " in
*" $TEST_NAME "*)
  printf "\t%-64s skipped, unsupported on current platform\n" "$TEST_FILE"
  exit 0
  ;;
esac

OUTPUT="$TEST_TEMP_DIRECTORY/$TEST_NAME.out"
mkdir -p "$TEST_TEMP_DIRECTORY"
"$BIN_DIR/invoke-koshkit" timeout -k 2s "${TEST_TIMEOUT_SECONDS:-60}" \
  "$BIN" -WWW --no-annoying-diagnostics - <"$TEST_FILE" \
  >"$OUTPUT" 2>&1

if diff "${DIFF_OPTIONS[@]}" "expected/$TEST_NAME.out" "$OUTPUT" >/dev/null 2>&1
then
  rm -f "$OUTPUT"
  exit 0
else
  diff "${DIFF_OPTIONS[@]}" "expected/$TEST_NAME.out" "$OUTPUT" >&2 || true
  rm -f "$OUTPUT"
  exit 1
fi
