#!/bin/bash

BIN_DIR=${0%/*}
TEST_SHELL_COMMAND=$1
REFILL_STATUS=0

for TEST_FILE in harness/kosh/*.kosh harness/cli/*.sh harness/completion/*.sh \
  harness/highlight/*.sh
do
  [ -f "$TEST_FILE" ] || continue
  TEST_NAME=${TEST_FILE##*/}
  TEST_NAME=${TEST_NAME%.*}

  if [ -n "${REFILL-}" ]; then
    case " $REFILL " in
    *" $TEST_NAME "*) ;;
    *) continue ;;
    esac
  fi

  OUTPUT="expected/.$TEST_NAME.out.tmp"
  case $TEST_FILE in
    harness/kosh/*.kosh)
      "$BIN_DIR/invoke-koshkit" timeout -k 2s "${TEST_TIMEOUT_SECONDS:-60}" \
        "$BIN" -WWW - <"$TEST_FILE" \
        >"$OUTPUT" 2>&1
      TEST_STATUS=$?
      case $TEST_STATUS in
        124) REFILL_STATUS=$TEST_STATUS ;;
        *) ;;
      esac
    ;;
    harness/cli/*.sh | harness/completion/*.sh | harness/highlight/*.sh)
      "$BIN_DIR/invoke-koshkit" timeout -k 2s "${TEST_TIMEOUT_SECONDS:-60}" \
        "$TEST_SHELL_COMMAND" "$TEST_FILE" >"$OUTPUT" 2>&1 || \
        REFILL_STATUS=$?
    ;;
  esac

  if [ "$REFILL_STATUS" -eq 0 ]
  then
    "$BIN_DIR/invoke-koshkit" mv "$OUTPUT" "expected/$TEST_NAME.out"
  else
    "$BIN_DIR/invoke-koshkit" rm -f "$OUTPUT"
  fi
done

exit "$REFILL_STATUS"
