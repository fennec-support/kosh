#!/bin/bash

BIN_DIR=${0%/*}
REFILL_STATUS=0

for TEST_FILE in harness/kosh/*.kosh harness/cli/*.sh harness/completion/*.sh \
  harness/highlight/*.sh
do
  [ -f "$TEST_FILE" ] || continue
  TEST_NAME=${TEST_FILE##*/}
  TEST_NAME=${TEST_NAME%.*}

  if [ -n "${REFILL-}" ]; then
    case " $REFILL " in
    *" $TEST_NAME "*) ;;
    *) continue ;;
    esac
  fi

  "$BIN_DIR/run-harness-script" "$TEST_FILE" --refill || REFILL_STATUS=$?
done

exit "$REFILL_STATUS"
