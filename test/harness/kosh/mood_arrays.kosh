#!/bin/env kosh
# Indexed array literals are a dash-rejected pure addition, so they run in the
# default strict mood, not only bash mode. The literal works the way the
# subscript and declare forms do, including the empty, the append, and the
# prefix sequence forms.
e=(a b)
echo "n=${#e[@]} all=${e[@]}"
e+=(c)
echo "appended=${e[2]}"
g=()
echo "empty_n=${#g[@]}"
flags= pvars=(p) specs=(s1 s2)
# shellcheck disable=array-without-subscript
echo "seq=$pvars ${specs[1]}"
f() { local a=(1 2); echo "local_arr=${a[1]}"; }
f

# An empty default on a whole array is a modifier, not a substring offset.
a=(x y)
echo "empty default, set: [${a[@]:-}]"
for c in "${a[@]:-}"; do echo "loop c=$c"; done

array_rehash=(kept)
array_index='probe_a[0]=0,probe_b[0]=0,probe_c[0]=0,probe_d[0]=0,probe_e[0]=0,probe_f[0]=0,probe_g[0]=0,probe_h[0]=0,probe_i[0]=0,probe_j[0]=0,probe_k[0]=0,probe_l[0]=0,probe_m[0]=0,probe_n[0]=0,probe_o[0]=0,probe_p[0]=0,probe_q[0]=0,probe_r[0]=0,probe_s[0]=0,probe_t[0]=0'
echo "rehash=${array_rehash[array_index]}"
