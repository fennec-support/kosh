#!/bin/env kosh
# shellcheck disable=constant-case-word,unmatchable-case-pattern,SC2249
case foo in f*) echo match;; *) echo no;; esac


case b in
  a) echo a ;;
  b) echo b ;&
  c) echo c ;;
esac
case hi in
  h*) echo h ;;&
  *i) echo i ;;&
  hi) echo exact ;;
esac

case x in #comment
 x) echo m;; esac
case posix in #(
 *posix*) echo p;; #(
 *) echo o;; esac

case b in
 a \
 | b) echo match;; esac
case z in
 a \
 | b) echo match;; *) echo default;; esac

case x in a) echo m ;; *) echo d ;; esac
case a in a) ;; esac
echo done

case a in (a) echo match;; esac
case b in (a) echo match;; (*) echo default;; esac

case a in a|b) echo match;; esac
case b in a|b) echo match;; esac
case c in a|b) echo match;; *) echo default;; esac

case x in a) echo hi;; esac
