root=$(mktemp -d)
cd "$root"

printf 'alpha:one\nbeta:two\ngamma:three\n' > records
printf 'a\tb\n123456789\n' > spaced
printf 'one\ntwo\nthree\nfour\n' > lines

koshkit cut -d : -f 2 records
koshkit cut -b 1-3,6 records
printf 'a\303\251z\n' | koshkit cut -c 2
printf 'abcdef\n' | koshkit cut -b '1-2 4'
printf 'a\303\251z\n' | koshkit cut -b 3 -n
printf 'a\303\251z\n' | koshkit cut -b 1-2 -n
printf 'a\303\251z\n' | koshkit cut -b 3- -n

koshkit expand -t 4 spaced
koshkit unexpand -a -t 4 spaced | koshkit expand -t 4
koshkit fold -w 4 lines
koshkit fold -s -w 6 <<<'one two three'

koshkit nl -ba -v 3 -i 2 -w 2 -s ': ' lines
koshkit paste -d , records lines
koshkit paste -s -d , lines

koshkit sed 's/:/=/; 2d' records
koshkit sed -n '2p' records
koshkit sed -n '2,3p' records
koshkit sed -e '1i\zero' records
koshkit sed -e '2a\after' records
koshkit sed -e '2,3c\replaced' records
koshkit sed 'y/ot/OT/' lines
printf 'alpha\nBETA\n' | koshkit grep -i '^[[:alpha:]]*ta$'
filler=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
koshkit yes "$filler" | koshkit head -n 4095 > boundary
printf '%sneedletail\nafter needle\nplain\n' \
  yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy >> boundary
koshkit grep -n needle boundary
koshkit grep -vn x boundary
printf 'xac\nxabbc\nzzz\n' | koshkit grep 'xab*c'
printf 'xac\nzzz\n' | koshkit grep -vn 'xab*c'
printf 'ac\nabc\n' | koshkit grep 'ab\{0,1\}c'
printf 'cat\ndog\nbird\n' | koshkit grep 'cat\|dog'
printf 'abde\nabxe\n' | koshkit grep 'ab[cd]e'
printf 'abc\nxabc\n' | koshkit grep '^abc$'
printf 'a.b\naxb\n' | koshkit grep 'a\.b'
printf 'ABC\nabd\n' | koshkit grep -i 'a.c'
printf 'abc\nxabc\nabcx\nab\n' | koshkit grep '^a.c$'
printf 'abc\nxabc\nabcx\nab\n' | koshkit grep -n 'a.c$'
printf 'a\n\nb\n' | koshkit grep -n ''
printf 'a\n\nb\n' | koshkit grep -n '^$'
printf 'a\n\nb\n' | koshkit grep -vn '^.*$'
printf 'ab\nxab\nabx\nba\n' | koshkit grep -n '.*ab.*'
printf 'ab\nxab\nabx\nba\n' | koshkit grep '^.*ab$'
printf 'ab\nabab\naab\n' | koshkit grep 'ab.*ab'
printf 'ab\nabab\naab\n' | koshkit grep '^a.*ab$'
printf 'a-b\naxb\nab\n' | koshkit grep -vn 'a.b'
printf 'ABC\nxabcx\nabd\n' | koshkit grep -in 'A.*C$'
printf 'ABC\nxabcx\nabd\n' | koshkit grep -i 'x.B'
printf 'axbb\naxb\nxaxbb\n' | koshkit grep '^a.*b\{2\}$'
printf 'axb\naxxb\n' | koshkit grep 'a.\{2\}b'
printf 'ab\n' | koshkit sed -E 's/a|b/x/g'
printf 'ab\n' | koshkit sed 's/a*/x/g'

koshkit split -l 2 lines part
koshkit cat partaa partab

koshkit pr -t lines
koshkit pr -t -w 20 -s : -2 lines
koshkit pr -t -a -w 20 -s : -2 lines
printf 'wide-one\nwide-two\n' |
  koshkit pr -t -l 1 -18446744073709551615
printf 'left-one\nleft-two\n' > left
printf 'right-one\nright-two\n' > right
koshkit pr -t -m -w 30 -s : left right
