#!/bin/env kosh

# A reader that takes part of a write and leaves keeps the bytes it took, so
# the next reader of the same process substitution starts after them. Wine
# reports no transferred bytes for a write its reader abandoned, so under Wine
# the next reader still receives the abandoned write again.
set -M bash
partial() {
  koshkit head -c 7 "$1"
  echo
  koshkit head -c 12 "$1"
  echo
  koshkit wc -c <"$1"
}
partial <(printf %s abcdefghijklmnopqrstuvwxyz0123456789)
