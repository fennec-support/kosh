#!/bin/env kosh
# shellcheck disable=octal-literal
(echo $((010 + 09)))
echo "octal=$?"
(echo $((2#102)))
echo "base2=$?"
(echo $((16#fg)))
echo "base16=$?"
(echo $((0b12)))
echo "binary=$?"
(echo $((0xZ)))
echo "hex=$?"
(echo $((1a)))
echo "decimal=$?"
(echo $((1%0)))
echo "modzero=$?"
(echo $((1 << -1)))
echo "negative_shift=$?"
(echo $((1 2)))
echo "trailing=$?"
(echo $((++)))
echo "bad_increment=$?"
( (( 1 / 0 )) )
echo "command_division=$?"
( (( 1 @ 2 )) )
echo "command_token=$?"
echo $((0x + 010 + 16#ff + 2#101))
(y=$((3 4)); echo "$y")
echo "assignment=$?"
(export z=$((5 6)))
echo "declaration=$?"
workers=0
(echo $((12 / workers)))
echo "variable_division=$?"
(echo $((12 % workers)))
echo "variable_modulo=$?"
(echo $((12 / (workers - workers))))
echo "expression_zero=$?"
(echo $((100 / 2 / workers)))
echo "later_chain=$?"
(echo $((1 + 12 / workers)))
echo "precedence=$?"
(value=12; (( value /= workers )))
echo "compound_division=$?"
(value=12; (( value %= workers )))
echo "compound_modulo=$?"
(echo $((12 / +0)))
echo "signed_literal=$?"
(echo $((12 / (4 / workers))))
echo "nested_zero=$?"
echo "short_circuit=$((0 && (12 / workers)))"
(evaluations=0; trap 'echo "evaluations=$evaluations"' EXIT; echo $((12 / (evaluations++))))
echo "single_evaluation=$?"
(formula='12 / workers'; echo $((formula)))
echo "stored_formula=$?"
