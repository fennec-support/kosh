# Windows maps a nice value to a priority class and its ps prints no nice
# value, so the nice deltas are checked on POSIX systems only. A delta other
# than 1 is printed. A busybox ps has no -p, so the nice value then comes from
# /proc.
nice_of() {
  ps -o ni= -p "$1" 2>/dev/null || cut -d' ' -f19 "/proc/$1/stat"
}
if [ "${OS-}" != Windows_NT ]; then
  base=$(sh -c 'ps -o ni= -p $$ 2>/dev/null || cut -d" " -f19 /proc/$$/stat')
  raised=$(koshkit nice -n 1 sh -c \
    'ps -o ni= -p $$ 2>/dev/null || cut -d" " -f19 /proc/$$/stat')
  [ "$((raised - base))" -eq 1 ] || echo "nice-delta=$((raised - base))"
fi
koshkit nice -n 1 printf 'nice-ok\n'
echo "nice=$?"

koshkit nohup printf 'nohup-ok\n'
echo "nohup=$?"

sleep 30 &
child=$!
[ "${OS-}" = Windows_NT ] || before=$(nice_of "$child")
koshkit renice -n 1 -p "$child" >/dev/null
echo "renice=$?"
if [ "${OS-}" != Windows_NT ]; then
  after=$(nice_of "$child")
  [ "$((after - before))" -eq 1 ] || echo "renice-delta=$((after - before))"
fi
kill "$child"
wait "$child"

koshkit logger -t koshkit-test process-message
echo "logger=$?"
