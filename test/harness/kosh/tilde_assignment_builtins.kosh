#!/bin/env kosh
test -d ~ && echo 1
test -d ~/ && echo 2
test ~+ = "$PWD" && echo tilde_plus
HOME=testhome
export E=~/a:~/b
echo "$E"
readonly R=~/r
echo "$R"
f() { local L=~/z; echo "$L"; }
f
declare D=~/d
echo "$D"
a=~/x b=~/y
echo "$a $b"
p=~/a:~/b:~
echo "$p"
q=~/only
echo "$q"
r=~/x:~/y
echo "$r"
