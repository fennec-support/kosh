#!/bin/env kosh
koshkit mkdir -p "$TEST_TEMP_DIRECTORY/subshell-state"
f() { echo parent; }
( f() { echo child; }; f )
f

set +e
( set -e; false; echo never-printed )
echo e-isolated-parent-survives
set +f
( set -f )
case $- in *f*) echo f-LEAKED;; *) echo f-isolated;; esac
set -f
( set +f )
case $- in *f*) echo f-still-set;; *) echo f-UNSET-LEAK;; esac
set +f

trap "echo PARENT" EXIT
( trap "echo SUB" EXIT; echo in-sub )
echo after-sub
( echo plain-sub )
echo after-plain
( exit 3 )
echo exit-rc=$?
v=$( trap "echo CSUB" EXIT; echo captured )
echo got=$v

set -- -ab
OPTIND=1
( getopts ab child_option )
getopts ab parent_option
echo "getopts-parent=$parent_option:$OPTIND"

export release=$TEST_TEMP_DIRECTORY/subshell-state/release-$BASHPID
while [ ! -e "$release" ]; do koshkit sleep 0.01; done &
parent_background=$!
( while [ ! -e "$release" ]; do koshkit sleep 0.01; done & : )
if [ "$!" = "$parent_background" ]; then
  echo background-pid-restored
else
  echo background-pid-leaked
fi
jobs -p > "$release.jobs"
if [ "$(koshkit wc -l < "$release.jobs")" -eq 1 ]; then
  echo jobs-restored
else
  echo jobs-leaked
fi
: > "$release"
wait "$parent_background"
(exit 3) &
for attempt in $(koshkit seq 500); do
  jobs | koshkit grep -q Exit && break
  koshkit sleep 0.01
done
jobs -l | koshkit sed 's/  *[0-9][0-9]* / PID /;s/  .*//'
jobs
x=1
(readonly x)
x=2
echo "x=$x"
n=5
(declare -i n)
n=abc
echo "n=$n"
arr=(a b)
(readonly arr)
arr=(c d)
echo "arr=${arr[1]}"
before_mask=$(umask)
(umask 077)
[ "$before_mask" = "$(umask)" ] && echo mask-restored
(pushd "$TEST_TEMP_DIRECTORY/subshell-state" >"$TEST_NULL_DEVICE"; umask 077)
[ "$(dirs -p | koshkit wc -l)" -eq 1 ] && echo directory-stack-restored
koshkit mkdir -p "$TEST_TEMP_DIRECTORY/subshell-state/original" "$TEST_TEMP_DIRECTORY/subshell-state/sibling"
: > "$TEST_TEMP_DIRECTORY/subshell-state/original/marker"
state_directory=$(cd "$TEST_TEMP_DIRECTORY/subshell-state" && pwd)
cd "$state_directory/original" || exit 1
(chmod 000 .; cd "$state_directory/sibling")
chmod 700 "$state_directory/original"
[[ -f marker ]] && echo permission-directory-restored
cd / || exit 1
echo done
