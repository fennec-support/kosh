# The csh both-streams spelling rides every mood but POSIX, so a bare >&file
# sends both streams to the file while >&3 keeps the descriptor duplication.
koshkit mkdir -p "$TEST_TEMP_DIRECTORY"
both=$TEST_TEMP_DIRECTORY/csh-both
"$TEST_SHELL" -c 'echo o; echo e >&2' >&"$both"
cat "$both"
koshkit unlink "$both"
exec 3>&1
echo fd3 >&3
exec 3>&-
