#!/bin/env kosh
# shellcheck disable=negation-skips-errexit,pipeline-non-reader,pipeline-read-assignment
echo 1 | cat | cat | cat;
echo 2 | cat && echo 3 | cat;
echo 4 | false || echo 4;
{ echo a; } | cat

printf 'yes\n' | if read -r answer && test "$answer" = yes; then
  echo if-direct
fi | cat
printf 'no\n' | if read -r answer && test "$answer" = yes; then
  echo if-missed
else
  echo if-else
fi | cat
printf 'later\n' | if read -r answer && test "$answer" = first; then
  echo if-missed
elif test "$answer" = later; then
  echo if-elif
fi | cat
printf 'case-value\n' | case "$(cat)" in
  case-value) echo case-stage ;;
  *) ;;
esac | cat
true | for ((pipeline_index = 0; pipeline_index < 2; pipeline_index++)); do
  echo "cfor-$pipeline_index"
done | cat

true | false
echo "tf=$?"
false | true
echo "ft=$?"
false | read -r x
echo "fr=$?"
echo hi | read -r y
echo "er=$?"
true | true
echo "tt=$?"
! true | false
echo "neg=$?"
