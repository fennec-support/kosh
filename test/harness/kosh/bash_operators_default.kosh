#!/bin/env kosh
koshkit mkdir -p "$TEST_TEMP_DIRECTORY"
amp_file=$TEST_TEMP_DIRECTORY/bash-operators-amp
echo through |& cat
{ echo to-err >&2; } |& cat
echo both &> "$amp_file"
cat "$amp_file"
echo more &>> "$amp_file"
cat "$amp_file"
koshkit unlink "$amp_file"
read -r first <<< "one two three"
echo "read=$first"
cat <<< "straight through"
total=0
while read -r n; do
  total=$(( total + n ))
done <<< "$(printf '3\n4\n5')"
echo "summed=$total"
csh_file=$TEST_TEMP_DIRECTORY/bash-operators-csh
{ echo to-out; echo to-err >&2; } >&"$csh_file"
echo "csh both streams:"
cat "$csh_file"
"$TEST_SHELL" -c 'echo program-out; echo program-err >&2' >&"$csh_file"
echo "csh program streams:"
cat "$csh_file"
echo hi >&/dev/null
echo after
exec 3>&1
echo fd3 >&3
exec 3>&-
koshkit unlink "$csh_file"
