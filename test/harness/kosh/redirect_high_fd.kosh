#!/bin/env kosh
echo plain_stdout 3>zz_high_fd_a
echo a-file:
cat zz_high_fd_a
"$TEST_SHELL" -c 'echo on_fd_three 1>&3' 3>zz_high_fd_b
echo b-file:
cat zz_high_fd_b
"$TEST_SHELL" -c 'echo three 1>&3; echo four 1>&4' 3>zz_high_fd_c 4>zz_high_fd_d
echo c-file:
cat zz_high_fd_c
echo d-file:
cat zz_high_fd_d
{ "$TEST_SHELL" -c 'echo group_three 1>&3'; } 3>zz_high_fd_e
echo e-file:
cat zz_high_fd_e
"$TEST_SHELL" -c 'cat <&3' 3<<EOF
heredoc_three
EOF
rm -f zz_high_fd_a zz_high_fd_b zz_high_fd_c zz_high_fd_d zz_high_fd_e
