#!/bin/env kosh
if false; then echo a; elif true; then echo elif_taken; else echo c; fi
if false; then echo a; elif false; then echo b; else echo else_taken; fi

# The colon builtin is a true condition.
if :; then echo colon_succeeds; fi

# A zero condition removes the C-style loop body, and the init clause still
# runs once.
for ((i = 0; 0; i++)); do echo never; done
echo after_zero
for ((x = 5; 0; x++)); do echo never; done
echo "x=$x"
for ((; 0;)); do echo never; done
echo after_blank

# A counter condition is not folded.
sum=0
for ((i = 1; i <= 4; i++)); do sum=$((sum + i)); done
echo "sum=$sum"

# An always-true loop condition keeps the body.
while true; do echo body_ran; break; done
until false; do echo until_body; break; done
