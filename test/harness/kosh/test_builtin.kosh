#!/bin/env kosh
# shellcheck disable=constant-test-operand,unassigned-variable-read,impossible-comparison,empty-test,SC2050,SC2157,SC2166,SC2170
test -s "$TEST_NULL_DEVICE"; echo $?
( test abc -eq 5 ); echo "invalid_number=$?"
test ! ""; echo $?
[ ]; echo $?
( test a -a b c ); echo "invalid_arity=$?"
test "$TEST_NULL_DEVICE" -nt "$TEST_NULL_DEVICE"; echo $?


[ ! ]
echo $?

[ "(" = "(" ]; echo "paren_eq=$?"
[ "(" ]; echo "paren_single=$?"
[ ")" ]; echo "rparen_single=$?"
[ "(" = ")" ]; echo "paren_ne=$?"
[ a \< b ]; echo "lt_true=$?"
[ b \< a ]; echo "lt_false=$?"
[ a \> b ]; echo "gt_false=$?"
[ b \> a ]; echo "gt_true=$?"
[ 10 \< 9 ]; echo "byte_lt=$?"
[ abc \< abd ]; echo "abc_lt_abd=$?"
[ \( a = a \) ]; echo "group_eq=$?"
[ \( a = a \) -a -n x ]; echo "group_and=$?"

unset UNSET_VAR
echo "== [ -z unset ]:"
[ -z "$UNSET_VAR" ]; echo "exit=$?"
echo "== [ -n unset ]:"
[ -n "$UNSET_VAR" ]; echo "exit=$?"
echo "== [ unset -ne 0 ] (builtin, integer expected):"
( [ "$UNSET_VAR" -ne 0 ] ) 2>&1; echo "exit=$?"
