#!/bin/env kosh
printf "tab\tnl\nff\fvt\v\n"
printf "%b\n" "\012x"
printf "%b\n" "lit\\\\"
printf "[%c]\n" ""
printf "100%%\n"
printf "%Q\n" hi
printf "%d\n" +5
printf "%.3s\n" abcdef
printf "end%"
echo

printf '%d\n' "'A"
printf '%x\n' "'A"
printf '%o\n' "'A"
printf '%u\n' "'A"
printf '%d\n' '"A'
printf '%d\n' "'AB"

printf '%d %d %x %o\n' 42 010 0x1f 8

printf '%300d\n' 5
printf '%.290f\n' 1

printf '%d\n' 99999999999999999999999999
echo "rc=$?"
printf '%d\n' -99999999999999999999
echo "rc=$?"
printf '%x\n' 0xffffffffffffffffffff
echo "rc=$?"
printf '%d\n' 42
echo "rc=$?"

printf '[%2000000000d]\n' 1
echo "rc=$?"
printf '[%.*s]\n' 99999999999 abc
echo "rc=$?"
printf '[%*d]\n' -3 7
echo "rc=$?"

# The \e and \E escapes emit ESC in the bash moods and stay literal in the sh
# mood. The %b conversion follows the same gate.
set -M bash
printf '\e' | koshkit od -An -c
printf '\E' | koshkit od -An -c
printf '%b' '\e' | koshkit od -An -c
set -M bash-posix
printf '\e' | koshkit od -An -c
set -M sh
printf '\e' | koshkit od -An -c
printf '%b' '\e' | koshkit od -An -c
set -M kosh
