koshkit cal 2 2024
cal_today=$(koshkit cal -a 2 2024)
printf '%s\n' "$cal_today" |
  koshkit grep '^Mo Tu We Th Fr Sa Su$' >/dev/null
echo "cal-monday-first=$?"
printf '%s\n' "$cal_today" | koshkit tail -n 2 |
  koshkit grep -c -e '^Today is .*, [0-9]*[.]$' -e '^It is day [0-9]* of the year[.]$' |
  koshkit grep -q '^2$'
echo "cal-today-description=$?"
koshkit cal 1 9223372036854775807 >/dev/null
echo "cal-large-year=$?"

koshkit date -u +%Y >/dev/null
echo "date=$?"
koshkit id -u >/dev/null
echo "id=$?"
koshkit id -zu | koshkit tr -d 0-9 | koshkit od -An -c
id_groups=$(koshkit id -G)
id_zero_groups=$(koshkit id -zG | koshkit tr '\0' ' ')
[ "$id_zero_groups" = "$id_groups " ]
echo "id-zero-groups=$?"
koshkit id -z
echo "id-zero-default=$?"
LC_ALL=C koshkit locale charmap >/dev/null
echo "locale=$?"
LC_ALL=C koshkit locale -ck decimal_point
LC_ALL=C koshkit locale -c charmap
LOGNAME=spoofed USER=spoofed koshkit logname >/dev/null
echo "logname-unspoofed=$?"
koshkit tty -s
echo "tty=$?"
koshkit uname -s >/dev/null
echo "uname=$?"
koshkit who >/dev/null
echo "who=$?"
koshkit who -Hq >/dev/null
echo "who-quick=$?"
koshkit who -m >/dev/null
echo "who-current=$?"
koshkit who -Tu >/dev/null
echo "who-state=$?"
pwdx_output=$(koshkit pwdx "$$")
[ "$pwdx_output" = "$$: $(pwd -P)" ]
echo "pwdx-self=$?"
pwdx_output=$(koshkit pwdx "/proc/$$")
[ "$pwdx_output" = "/proc/$$: $(pwd -P)" ]
echo "pwdx-proc=$?"
true &
pwdx_reaped=$!
wait "$pwdx_reaped"
koshkit pwdx "$pwdx_reaped" 2>/dev/null
echo "pwdx-reaped=$?"
koshkit pwdx abc 2>/dev/null
echo "pwdx-invalid=$?"
pwdx_error=$(koshkit pwdx 4294967797 2>&1)
case $pwdx_error in
  *"Invalid process id"*) echo "pwdx-out-of-range=invalid" ;;
  *) echo "pwdx-out-of-range=$pwdx_error" ;;
esac
koshkit pwdx 2>/dev/null
echo "pwdx-missing=$?"
