#!/bin/env kosh

# A background job, a pipeline stage, and a process substitution run in a fresh
# evaluator on Windows. Its diagnostics, traces, and LINENO name the lines and
# columns of this source, as a forked child does, without a second analysis.
echo start; ( echo "background"; echo "$unset_in_background" ) &
wait "$!"

( echo "first=$LINENO"
  echo "second=$LINENO" ) &
wait "$!"

echo piped | { read -r value; echo "$value $LINENO"; echo "$unset_in_stage"; }

echo nested | { ( echo "nested=$LINENO"; echo "$unset_in_nested" ) & wait; }

report() {
  ( echo "function=$LINENO" ) &
  wait "$!"
}
report

cat <(echo "input=$LINENO")
cat <(
  echo "multi=$LINENO"
  echo "after=$LINENO"
)
collected=$(echo "output=$LINENO" > >(cat); wait)
echo "$collected"
