#!/bin/env kosh

# A background job, a pipeline stage, and a process substitution run in a fresh
# evaluator on Windows. Its diagnostics, traces, and LINENO name the lines and
# columns of this source, as a forked child does, without a second analysis.
echo start; ( echo "background"; echo "$unset_in_background" ) &
wait "$!"

( echo "first=$LINENO"
  echo "second=$LINENO" ) &
wait "$!"

echo piped | { read -r value; echo "$value $LINENO"; echo "$unset_in_stage"; }

echo nested | { ( echo "nested=$LINENO"; echo "$unset_in_nested" ) & wait; }

report() {
  ( echo "function=$LINENO" ) &
  wait "$!"
}
report

koshkit cat <(echo "input=$LINENO")
koshkit cat <(
  echo "multi=$LINENO"
  echo "after=$LINENO"
)
collected=$(echo "output=$LINENO" > >(cat); wait)
echo "$collected"

# The frames above the launch site, the callers of a function, an enclosing
# subshell, and a process substitution, appear in the trace of the child.
report_unset() {
  ( echo "$unset_in_report" ) &
  wait "$!"
}
outer_report() { report_unset; }
outer_report

( ( echo "$unset_in_inner" ) & wait )

koshkit cat <(echo "$unset_in_input")

eval 'koshkit cat <(echo "eval=$LINENO")'

# A function defined before the launch keeps its own lines and call stack.
show_frames() {
  echo "show=$LINENO ${BASH_LINENO[*]} ${FUNCNAME[*]} $unset_in_show"
}
koshkit cat <(show_frames)
call_show() { koshkit cat <(show_frames); }
call_show
