report=$(koshkit --color never evillogs --cores)
case $report in
  'Core dump settings'*) echo "settings-title=flush" ;;
  *) echo "settings-title=missing" ;;
esac
case $report in
  *' '$'\n'*) echo "trailing-space=present" ;;
  *) echo "trailing-space=absent" ;;
esac
logs=$(koshkit --color never evillogs --logs)
case $logs in
  *'Core dump settings'*) echo "cores-in-logs=present" ;;
  *) echo "cores-in-logs=absent" ;;
esac
case $report in
  *' entries, '*) echo "logs-in-cores=present" ;;
  *) echo "logs-in-cores=absent" ;;
esac
both=$(koshkit --color never evillogs --cores --logs)
case $both in
  'Core dump settings'*) echo "both-title=flush" ;;
  *) echo "both-title=missing" ;;
esac
