#!/bin/env kosh
# shellcheck disable=directory-change-and-back
start=$PWD
koshkit mkdir -p .test-work/cd-paths/parent/child
cd .test-work/cd-paths/parent/child || exit
koshkit basename "$PWD"
cd .. || exit
koshkit basename "$PWD"
cd - > "$start/.test-work/cd-output" || exit
koshkit basename "$(koshkit cat "$start/.test-work/cd-output")"
koshkit basename "$PWD"
cd ../.. || exit
CDPATH="$TEST_PATH_SEPARATOR" cd parent > cd-output || exit
echo "cdpath=$?"
cd "$start" || exit
koshkit mkdir -p "$TEST_TEMP_DIRECTORY/cd-dash/first" "$TEST_TEMP_DIRECTORY/cd-dash/second"
cd "$TEST_TEMP_DIRECTORY/cd-dash/first" || exit
cd ../second || exit
cd - >/dev/null || exit
echo "PWD=$(koshkit basename "$PWD") OLDPWD=$(koshkit basename "$OLDPWD")"
cd - >/dev/null || exit
koshkit basename "$PWD"
cd "$start" || exit
# set -P carried into the sh mood leaves cd and pwd logical, so pwd and PWD
# agree.
koshkit mkdir -p "$TEST_TEMP_DIRECTORY/cd-physical/real"
if koshkit ln -s real "$TEST_TEMP_DIRECTORY/cd-physical/link" 2>/dev/null
then
  (
    koshconf set mood bash
    set -P
    koshconf set mood sh
    cd "$TEST_TEMP_DIRECTORY/cd-physical/link" || exit
    echo "pwd-sh=$(koshkit basename "$(pwd)")"
  )
else
  echo "pwd-sh=link"
fi
