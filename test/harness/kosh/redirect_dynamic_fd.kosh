#!/bin/env kosh
koshkit mkdir -p "$TEST_TEMP_DIRECTORY"
dyn_file=$TEST_TEMP_DIRECTORY/redirect-dynamic-fd
err_file=$TEST_TEMP_DIRECTORY/redirect-dynamic-fd-error
fd=5
{ echo dyn-builtin >&$fd; echo lit-builtin >&5; "$TEST_SHELL" -c 'printf "dyn-extern\n"' >&$fd; } 5>"$dyn_file"
echo "descriptor 5 file:"
cat "$dyn_file"
errfd=2
"$TEST_SHELL" -c 'printf "to-stderr-before\n"' >&$errfd 2>"$err_file"
echo "error file after a dup written first:"
cat "$err_file"
"$TEST_SHELL" -c 'printf "to-stderr-after\n"' 2>"$err_file" >&$errfd
echo "error file after a dup written last:"
cat "$err_file"
koshkit unlink "$dyn_file"
koshkit unlink "$err_file"
