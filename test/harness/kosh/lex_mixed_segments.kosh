#!/bin/env kosh
# shellcheck disable=unquoted-command-substitution
show() { printf '[%s]' "$@"; echo; }
x=X y=Y b=B
d=$(mktemp -d)
cd "$d" || exit
touch axb cyd m litq b

show pre"dq"'sq'$x${y}post
show "a$b"'c'$(printf p)"d$(( 1 + 1 ))e"

show $(( 1 + 2 ))
show pre$(( 3 * 4 ))post
show "val=$(( 5 - 1 ))end"
show $(( 6 ))$(( 7 ))

show "$(printf p)"
show pre$(printf p)post
show "head$(printf p)tail"
show $(printf p)$(printf q)

show a\*b c\?d
show \$foo \~home
show \" \\ \`
show pre\ space

show a*b c?d [m-n]
show "lit*" 'lit?' "[abc]"

show bare 'single' "double"
show pre'mid'post
show out"in"out
show 'one''two'"three"

cd / || exit
rm -r "$d"
