#!/bin/env kosh
# shellcheck disable=unquoted-command-substitution
show() { printf '[%s]' "$@"; echo; }
HOME=/home/segments
x=X y=Y b=B

show pre"dq"'sq'$x${y}post
show "a$b"'c'$(printf p)"d$(( 1 + 1 ))e"

show $(( 1 + 2 ))
show pre$(( 3 * 4 ))post
show "val=$(( 5 - 1 ))end"
show $(( 6 ))$(( 7 ))

show "$(printf p)"
show pre$(printf p)post
show "head$(printf p)tail"
show $(printf p)$(printf q)

show a\*b c\?d
show \$foo \~home
show \" \\ \`
show pre\ space

set -f
show a*b c?d [a-z]
show "lit*" 'lit?' "[abc]"

show bare 'single' "double"
show pre'mid'post
show out"in"out
show 'one''two'"three"

show ~ ~nosuchuser_xyz ~/path
show pre~mid "~quoted" '~raw'
