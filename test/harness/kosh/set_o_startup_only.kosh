#!/bin/env kosh
# login_shell reports the startup login state and cannot be changed. The former
# Koshka -o login and -o rcfile names are unknown to the -o test.
if shopt -q login_shell; then echo login=on; else echo login=off; fi
if [[ -o login ]]; then echo o-login=on; else echo o-login=off; fi
if [[ -o rcfile ]]; then echo o-rcfile=on; else echo o-rcfile=off; fi
koshconf get kosh.interpreter.login_shell
koshconf set kosh.interpreter.login_shell on
echo "rc=$?"
shopt -s login_shell
shopt -q login_shell || echo login-still-off
