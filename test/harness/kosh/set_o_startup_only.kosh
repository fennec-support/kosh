#!/bin/env kosh
# login_shell reports the startup login state and cannot be changed.
if shopt -q login_shell; then echo login=on; else echo login=off; fi
koshconf get bash.interpreter.login_shell
koshconf set bash.interpreter.login_shell on
echo "rc=$?"
shopt -s login_shell
shopt -q login_shell || echo login-still-off
