== the kosh mood stores as well:
declare -a stored=([0]="alpha")
== an invalid name is refused:
-c:1:12: error: Builtin `compgen`: 'stored[0]' is not a valid identifier.
     1 |  compgen -V "stored[0]" -W "alpha" -- a
       |             ^~~~~~~~~~~
status=2
== an associative target is refused:
-c:2:12: error: Builtin `compgen`: 'stored' is not an indexed array.
     2 |  compgen -V stored -W "alpha" -- a
       |             ^~~~~~
status=1
== a read only target is refused:
-c:2:12: error: Builtin `compgen`: 'stored' is read-only.
     2 |  compgen -V stored -W "alpha" -- a
       |             ^~~~~~
status=1
== a missing option value is a usage error:
-c:1:20: error: Builtin `compgen`: No value provided for '-V' flag.
     1 |  compgen -W "alpha" -V
       |                     ^~
status=2
