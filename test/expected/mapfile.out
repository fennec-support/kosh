[CompoundList]
  [CompoundListCondition, None]
    [SimpleCommand "mapfile" "-t" "rows"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "rows=$rows[0],$rows[1]"]
  [CompoundListCondition, None]
    [SimpleCommand "mapfile" "-u" "999" "rows"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "read_status=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "mapfile" "-s" "1" "-u" "999" "rows"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "skip_status=$?"]
[Word
  Unquoted "mapfile"
]
[Word
  Unquoted "-t"
]
[Word
  Unquoted "rows"
]
[Word
  Literal "first
second"
]
[Word
  Unquoted "echo"
]
[Word
  DoubleQuoted "rows="
  Variable "rows[0]"
  DoubleQuoted ","
  Variable "rows[1]"
]
