(span "ble/highlight/layer:{selection}/getg" :role function-name)
(span "ble/highlight/layer:{selection}/getg" :role resolved-command)
(span "ble/prompt/unit:{section}/get" :role function-name)
(span "ble/prompt/unit:{section}/get" :role resolved-command)
(span "bad{1..3}" :role invalid-syntax)
(span "bad{unclosed" :role invalid-syntax)
(span "g" :role unknown-command)
(span "g" :role function-name)
(span "g" :role resolved-command)
(span "ble/util/put" :role function-name)
(span "ble/util/put" :role resolved-command)
(span "ble/variable#load:x" :role function-name)
(span "ble/variable#load:x" :role resolved-command)
