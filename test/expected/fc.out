== list ranges and order ==
	 echo alpha
	 echo old-old
	 false
	 false
	 echo old-old
	 echo alpha
	 echo alpha
	 echo old-old
	 echo alpha
	 echo old-old
	 false
	 echo alpha
	 echo alpha
	 false
== execute and substitute ==
echo new-new
new-new
rc=0
	 echo alpha
	 echo old-old
	 echo new-new
echo new-new
new-new
rc=0
echo old-old
old-old
rc=0
false
rc=1
== rewrite a private event without importing a peer ==
echo local-new
local-new
	 false
	 echo local-new
echo alpha
echo old-old
false
echo peer
echo local-new
== editor selection and current shell ==
edited_value=explicit
explicit
