fcedit
edited_value=editor
editor
edited_value=vi
vi
edited_value=ed
ed
editor-rc=1
return 7
edit-return-rc=7
history -c
echo after-clear
history
after-clear
    1  echo after-clear

    2  history

== multiline history ==
	 echo first
echo second
echo first
echo second
first
second
