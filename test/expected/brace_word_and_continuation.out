== echo {a..e} "x y"
(span "echo" :role resolved-command)
(span "\"x y\"" :role string)
== echo "$(echo {a..e})" "x y"
(span "echo" :role resolved-command)
(span "\"" :role string)
(span "echo" :role resolved-command)
(span "\"" :role string)
(span "\"x y\"" :role string)
== { echo a; } | cat
(span "{" :role operator)
(span "echo" :role resolved-command)
(span ";" :role operator)
(span "}" :role operator)
(span "|" :role operator)
(span "cat" :role resolved-command)
== function g { echo; }
(span "function" :role keyword)
(span "g" :role function-name)
(span "{" :role operator)
(span "echo" :role resolved-command)
(span ";" :role operator)
(span "}" :role operator)
== x=$(\
  A=1 \
    cat)
(span "x" :role assignment-name)
(span "A" :role assignment-name)
(span "cat" :role resolved-command)
== myfn() { :; }; echo "$(myfn)" `myfn`
(span "myfn" :role function-name)
(span "(" :role operator)
(span ")" :role operator)
(span "{" :role operator)
(span ":" :role resolved-command)
(span ";" :role operator)
(span "}" :role operator)
(span ";" :role operator)
(span "echo" :role resolved-command)
(span "\"" :role string)
(span "myfn" :role resolved-command)
(span "\"" :role string)
(span "myfn" :role resolved-command)
== myfn() { :; }; unset -f myfn other; unset -v myfn
(span "myfn" :role function-name)
(span "(" :role operator)
(span ")" :role operator)
(span "{" :role operator)
(span ":" :role resolved-command)
(span ";" :role operator)
(span "}" :role operator)
(span ";" :role operator)
(span "unset" :role resolved-command)
(span "-f" :role flag)
(span "myfn" :role function-name)
(span "other" :role unknown-command)
(span ";" :role operator)
(span "unset" :role resolved-command)
(span "-v" :role flag)
(span "myfn" :role unset-variable)
(span "# comment" :role comment)
(span "inner-command" :role unknown-command)
(span "echo" :role resolved-command)
(span "printf" :role resolved-command)
(span "\")\"" :role string)
(span "echo" :role resolved-command)
(span "probecmd" :role resolved-command)
(span "esac" :role keyword)
