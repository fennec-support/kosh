--- du -s prints allocated bytes ---
du-allocated=matched
--- du -sh is human-readable ---
du-human=scaled
--- ls -l prints bytes ---
-rw-r--r-- 1 1892 big.txt
--- ls -lh is human-readable ---
-rw-r--r-- 1 1.8K big.txt
--- cp -v prints the copy ---
'big.txt' -> 'copy.txt'
--- mv -v prints the move ---
renamed 'copy.txt' -> 'moved.txt'
