== a bash-mood set -u abort exits 1 like a bash script, not 127 ==
setu.sh:2:7: error: Unable to expand 'undefined_variable' because the parameter is not set.
     2 |  echo "$undefined_variable"
       |        ^~~~~~~~~~~~~~~~~~~
note: Replace it with ${undefined_variable-} if empty expansion is desired.
rc=1
== a bash-mood ${name:?} abort exits 1 like a bash script ==
report.sh:1:6: error: missing: is gone.
     1 |  echo "${missing:?is gone}"
       |       ^~~~~~~~~~~~~~~~~~~~~
rc=1
== a -c string ends 127 in the bash moods on a fatal expansion error ==
kosh [echo ${x:?m}; echo after] rc=1
kosh [set -u; echo $u; echo after] rc=1
kosh [x=a; echo ${x@Z}; echo after] rc=1
kosh [echo $((1/0)); echo after] rc=1
kosh [f() { echo ${x:?m}; }; f; echo after] rc=1
kosh [set -e; echo ${x:?m}; echo after] rc=1
kosh [(echo ${x:?m}); echo "sub rc=$?"] rc=1
kosh [trap 'echo trap saw $?' EXIT; echo ${x:?m}] rc=1
bash [echo ${x:?m}; echo after] rc=127
bash [set -u; echo $u; echo after] rc=127
bash [x=a; echo ${x@Z}; echo after] rc=127
bash [echo $((1/0)); echo after] rc=1
bash [f() { echo ${x:?m}; }; f; echo after] rc=127
bash [set -e; echo ${x:?m}; echo after] rc=1
sub rc=1
bash [(echo ${x:?m}); echo "sub rc=$?"] rc=0
trap saw 127
bash [trap 'echo trap saw $?' EXIT; echo ${x:?m}] rc=127
bash-posix [echo ${x:?m}; echo after] rc=127
bash-posix [set -u; echo $u; echo after] rc=127
bash-posix [x=a; echo ${x@Z}; echo after] rc=127
bash-posix [echo $((1/0)); echo after] rc=127
bash-posix [f() { echo ${x:?m}; }; f; echo after] rc=127
bash-posix [set -e; echo ${x:?m}; echo after] rc=1
sub rc=1
bash-posix [(echo ${x:?m}); echo "sub rc=$?"] rc=0
trap saw 127
bash-posix [trap 'echo trap saw $?' EXIT; echo ${x:?m}] rc=127
sh [echo ${x:?m}; echo after] rc=2
sh [set -u; echo $u; echo after] rc=2
sh [x=a; echo ${x@Z}; echo after] rc=2
sh [echo $((1/0)); echo after] rc=2
sh [f() { echo ${x:?m}; }; f; echo after] rc=2
sh [set -e; echo ${x:?m}; echo after] rc=2
sub rc=2
sh [(echo ${x:?m}); echo "sub rc=$?"] rc=0
trap saw 2
sh [trap 'echo trap saw $?' EXIT; echo ${x:?m}] rc=2
== a script file and standard input keep status 1 ==
file rc=1
stdin rc=1
== the EXIT trap reads the status a fatal expansion error ends with ==
trap saw 1
kosh trap_report.sh rc=1
kosh trap_setu.sh rc=1
trap saw 1
kosh trap_arith.sh rc=1
trap saw 1
bash trap_report.sh rc=1
trap saw 1
bash trap_setu.sh rc=1
after
trap saw 0
bash trap_arith.sh rc=0
trap saw 1
bash-posix trap_report.sh rc=1
trap saw 1
bash-posix trap_setu.sh rc=1
trap saw 1
bash-posix trap_arith.sh rc=1
trap saw 2
sh trap_report.sh rc=2
trap saw 2
sh trap_setu.sh rc=2
trap saw 2
sh trap_arith.sh rc=2
