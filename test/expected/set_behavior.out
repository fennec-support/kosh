== set -e aborts before the next command:
rc=1
== set +e lets the run continue:
reached
rc=0
== an unknown mood is rejected:
-c:1:12: error: Builtin `set`: Unknown --mood value 'badmood', expected 'kosh', 'bash', 'sh', or 'bash-posix'.
     1 |  set --mood badmood
       |             ^~~~~~~
rc=1
== set -o lists the option states:
allexport      	off
annoying-diagnostics	on
auto-pair      	off
braceexpand    	on
emacs          	off
errexit        	off
errtrace       	off
extended-arithmetic	on
extended-keys  	on
failglob       	on
functrace      	off
hashall        	on
histexpand     	off
history        	off
history-prefix-search	on
ignoreeof      	off
interactive-comments	on
interactive-diagnostics	on
interactive-hints	on
keyword        	off
koshkit        	off
mimicry        	off
monitor        	off
no-diagnostics 	off
noclobber      	off
noexec         	off
noglob         	off
nolog          	off
notify         	off
nounset        	on
onecmd         	off
physical       	off
pipefail       	on
posix          	off
privileged     	off
space-after-completion	off
transient-prompt	off
verbose        	off
vi             	off
xtrace         	off
== bash mood relaxes nounset:
[]
ok
== -M short form prints the active mood:
sh
== default mood is strict:
is not set
== switching back to kosh restores strictness:
is not set
rc-done
notify         	off
notify         	on
notify         	off
rc=0
== set -o posix enters posix mood:
posix          	on
== set +o posix from bash mood is a no-op:
posix          	off
== set +o posix from posix mood steps to bash:
posix          	off
== brew's two failing lines now pass:
ok
rc-done
== a background subshell lists the initialized moods:
kosh
kosh
rc=0
