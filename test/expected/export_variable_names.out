== export completes variable words without an equals suffix:
KOSH_EXPORT_COMPLETION_UNIQUE
export-candidate=plain
== an assignment value is not completed with variable words:
export-value=none
export-value-prefix=none
== binding builtins complete variable words after their options:
export -n=plain
readonly=plain
readonly -a=plain
declare=plain
declare -x=plain
declare -p=plain
typeset=plain
typeset -r=plain
local=plain
local -i=plain
== function selecting options do not complete variable words:
declare -f=none
declare -F=none
declare -fx=none
typeset -f=none
typeset -F=none
export -f=none
readonly -f=none
== unset completes a variable name:
completion_probe_var
== unset completes a dynamic ANSI variable name:
KOSH_ANSI_RED
KOSH_ANSI_RESET
== unset -f completes a function name:
completion_probe_fn
== plain unset does not offer a function name:
