== export completes variable names without an equals suffix:
KOSH_EXPORT_COMPLETION_UNIQUE
export-candidate=plain
== an assignment value is not completed with variable names:
export-value=none
export-value-prefix=none
== binding builtins complete variable names after their options:
export -n=plain
readonly=plain
readonly -a=plain
declare=plain
declare -x=plain
declare -p=plain
typeset=plain
typeset -r=plain
local=plain
local -i=plain
== function selecting options do not complete variable names:
declare -f=none
declare -F=none
declare -fx=none
typeset -f=none
typeset -F=none
export -f=none
readonly -f=none
