chmod-octal=-rw-r-----
chmod-symbolic=-rwxrwx---
chmod-recursive=0 -rw-r--r--
chmod-umask=-rw-r--r--
chown=0
chown-name=0
chgrp=0
chown-no-dereference=0
chown-dereference=1
chown-physical=0
chown-arguments=0
chown-argument-dereference=1
chown-logical=1
chown-logical-physical=0
chown-physical-logical=1
chown-loop=1
chgrp-no-dereference=0
chgrp-physical=0
chgrp-arguments=0
chgrp-logical=1
ln-symbolic=0
mkfifo=prw-------
mkfifo-existing=1
mkfifo-symbolic=pr--r--r--
