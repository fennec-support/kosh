== a default option queries off:
dotglob             	off
rc=1
== set then query:
dotglob             	on
rc=0
== unset then query:
dotglob             	off
rc=1
== -q is silent and reports off through the status:
rc=1
== -q reports on through the status:
rc=0
== -p prints the replayable form when off:
shopt -u dotglob
== -p prints the replayable form when on:
shopt -s dotglob
== an unknown name is an error:
-c:1:7: error: Builtin `shopt`: 'bogusopt' is not a valid shell option name.
     1 |  shopt bogusopt
       |        ^~~~~~~~
rc=1
== an unknown name under -q is silent:
rc=1
== -o queries a set option name:
noexec              	off
rc=1
== sourcepath controls PATH lookup:
path
on=0
local
off=0
== inherit_errexit controls command substitutions:
off=0:kept
off-rc=0
on-rc=1
== lastpipe controls the final builtin:
default=<>
lastpipe=<y>
monitor=<y>
group=<group>
function=<function>
== localvar_inherit controls bare locals:
value=<> set=
value=<outer> set=x
integer=5
declare -x exported
array=one two
== checkhash controls cached command validation:
first
-c:4:1: error: Unable to execute `.test-work/checkhash-first/checkhash-probe`: No such file or directory.
     4 |  checkhash-probe
       |  ^~~~~~~~~~~~~~~
off=127
second
on=0
rehash=0
== hash -R rebuilds the PATH index:
rehash first
rehash second
== autocd changes directories in an interactive shell:
default=0
absolute=one
parent=yes
relative=two
option-name=-P
dot-one=three
dot-two=two
dot-three=one
dot-root=/
dot-program
dot-precedence=0
literal=...
disabled=yes
dot-disabled=rejected
extra-operand=rejected
dot-extra=rejected
reenabled=one
== autocd is enabled in the Bash mood by default but not in a script:
bash-default=0
bash-directory=autocd status=127
bash-dot-two=four
