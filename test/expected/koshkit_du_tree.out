--- tree ---
└─┬ t
  ├─┬ a
  │ ├─┬ b
  │ │ └── big
  │ └── mid
  ├── top
  ├─┬ c
  │ └── small
  ├── x1
  └── x2
--- tree sizes match the flat listing ---
tree-root-size=matched
tree-leaf-size=matched
--- tree human sizes ---
└─┬ t
  ├─┬ a
  │ ├─┬ b
  │ │ └── big
  │ └── mid
  ├── top
  ├─┬ c
  │ └── small
  ├── x1
  └── x2
--- tree summary ---
└── t
└── t/c
--- tree operands ---
└─┬ t/a
  ├─┬ b
  │ └── big
  └── mid
└─┬ .
  ├─┬ a
  │ ├─┬ b
  │ │ └── big
  │ └── mid
  ├── top
  ├─┬ c
  │ └── small
  ├── x1
  └── x2
└─┬ ./a/
  ├─┬ b
  │ └── big
  └── mid
--- top-largest ---
└─┬ t
  ├─┬ a
  │ ├─┬ b
  │ │ └── big
  │ └── mid
  ├── top
  ├─┬ c
  │ └── small
  ├── x1
  └── x2
top-human=yes
└── t
--- top-largest default count ---
top-lines=36
└─┬ m
  ├─┬ deep
  │ └─┬ er
  │   └─┬ est
  │     └── huge
  ├── f40
  ├── f39
  ├── f38
...
  ├── f12
  ├── f11
  └── f10
top-has-deep=yes
top-has-er=yes
top-has-est=yes
top-has-huge=yes
top-has-f40=yes
top-has-f10=yes
top-has-f09=no
top-has-f01=no
--- top-largest orders by name on equal sizes ---
  ├── n01
  ├── n02
  ├── n20
ties-lines=26
--- top-largest operands ---
└─┬ .
  ├─┬ a
  │ ├─┬ b
└─┬ t/a
  ├─┬ b
  │ └── big
  └── mid
└─┬ t/c
  └── small
--- top-largest with an unreadable directory ---
--- one file system ---
one-fs-local=same
--- help ---
  du [-shxT] [--tree] [path ...]
      --tree                            Print the entries as a tree, largest
  -T, --top-largest                     Print a human-readable tree of only the
