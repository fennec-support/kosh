== open constructs
echo "abc => Unterminated string literal, expected " here
echo 'abc => Unterminated string literal, expected ' here
echo $(ls => Unterminated command substitution, expected ) here
echo `ls => Unterminated command substitution, expected ` here
echo ${x => Unterminated variable expansion, expected } here
echo $((1 + => Unterminated arithmetic expansion, expected )) here
cat <(ls => Unterminated process substitution, expected ) here
a=(1 2 => Unterminated array assignment, expected ')'
(echo hi => Unterminated subshell, expected ')'
{ echo hi => Unterminated brace group, expected '}'
f() { => Unterminated brace group, expected '}'
[[ a == b => Unterminated '[[', expected ']]'
if true => Unterminated if, expected 'then' after the condition
if (true) => Unterminated if, expected 'then' after the condition
if true; then => Unterminated if, expected 'fi'
while true => Unterminated loop, expected 'do'
for x in a b => Unterminated for loop, expected 'do'
for x in a; do  => Unterminated for loop, expected 'done'
case x in => Unterminated case, expected a pattern to start an arm, or 'esac' to end the case
echo $(if true; then => Unterminated command substitution, expected ) here
== operators and redirections
ls | => Unable to build the pipeline because no command follows the pipe to receive the output
ls |& => Unable to build the pipeline because no command follows the pipe to receive the output
ls && => Expected a command after an operator
ls || => Expected a command after an operator
| ls => Expected a command before the pipe
&& ls => Expected a command before operator, found '&&'
echo > => Expected a filename after the redir
cat < => Expected a filename after the redir
cat << => Expected a heredoc delimiter
== stray and misplaced words
echo ) => ')' has no matching '('
echo ;; => ';;' is only valid between the arms of a 'case'
fi  => 'fi' has no matching 'if'
echo; done  => 'done' has no matching 'while', 'until', or 'for'
case x  => Expected an unquoted 'in' after the case word
function  => Expected a name after the 'function' keyword
for 1x in a; do => Bad for loop variable, '1x' is not a plain name, drop the '$' and any quotes
if true; then echo fi => Unterminated if, this 'fi' was read as an argument, so put a ';' or a newline before it
== empty bodies
( ) => Unable to parse the subshell, the body between '(' and ')' is empty, a command is required
{ } => Unable to parse the brace group, the body between '{' and '}' is empty, a command is required
if ( ) => Unable to parse the subshell, the body between '(' and ')' is empty, a command is required
f() ( ) => Unable to parse the subshell, the body between '(' and ')' is empty, a command is required
f() { } => Unable to parse the brace group, the body between '{' and '}' is empty, a command is required
while true; do done  => Unable to parse the loop, the body between 'do' and 'done' is empty, a command is required
== word still being typed
fi => 
echo; esac => 
case x => 
function => 
if => 
== continued on enter
echo \ => echo [-neE] [arg ...]
echo "abc\ => echo [-neE] [arg ...]
== clean lines
echo "abc" $(ls) ${x} => echo [-neE] [arg ...]
echo hi # "abc => echo [-neE] [arg ...]
echo \"abc => echo [-neE] [arg ...]
read x <<EOF => read [-ers] [-a name] [-d delim] [-n count] [-p prompt] [-t timeout] [-u fd] [-q] [name ...]
if true; then echo; fi => 
f() { :; } => 
