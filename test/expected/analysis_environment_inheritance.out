plain: 0
bash shebang: 1
kosh shebang: 1
operand: 1
nested -c: warnings=3
explicit -W: 0 1
reset: 0
unset: []
mimicry: mimicry warnings=3
mimicry off: warnings=3
sourced plain: 0
sourced -WW: 1
sourced inherited level: 1
sourced inherited mimicry only: 0
script plain: 0
script -WW: 1
sourced default mood: 1
explicit resync: warnings=1
