plain () 
{ 
    echo hi
}
truncated () 
{ 
    echo hi
} > /dev/null
paired () 
{ 
    echo hi
} > /dev/null 2>&1
closed () 
{ 
    :
} 2>&-
heredoc () 
{ 
    cat
} <<EOF
data
EOF

herestring () 
{ 
    cat
} <<< here
keyword () 
{ 
    for i in 1 2;
    do
        :;
    done
} > /dev/null
-- plain
hi
-- truncated
-- paired
-- heredoc
data
-- herestring
here
-- keyword
-- filed
file:
filed
-- stderr_closed
closed-status=2
