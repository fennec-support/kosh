== the kosh preset matches a fresh kosh session:
rc=0
# Koshka settings written by koshconf create kosh.
# Each line is name=value. kosh(5) describes the format.
# Every shell loads this file, including the ones that run scripts.

# Choose the grammar and the startup files: kosh, sh, bash, or bash-posix.
mood=kosh

# Show completion candidates in the interactive menu, an external selector, or a
# plain list.
completion.menu_style=interactive
# Insert a space after an accepted completion: off for never, on for always, or
# on-excluding-trailing-slash for all but a directory.
completion.add_space_after_completed_word=off
# Complete the word under the cursor on Tab. Turning this off also turns off the
# ghost suggestion and the syntax colors.
completion.on_tab=on

# Show the synopsis or flag description of the command under the cursor below
# the input.
editor.hints.show_command_synopsis=on
# Show the syntax problem or analysis finding of the line below the input.
editor.hints.show_live_diagnostics=on

# Insert the closer after a typed bracket, brace, or quote.
editor.auto_close_brackets_and_quotes=off
# Redraw a submitted or interrupted line after PS1_TRANSIENT and without RPS1.
editor.transient_prompt_after_submit=off
# Ask the terminal to report modified keys such as Ctrl-Shift-Z separately while
# a line is read.
editor.request_extended_key_reports=on
# Color the input by syntax and suggest the rest of the word in ghost text. Both
# also need completion.on_tab on.
editor.highlight_syntax_and_show_ghost_text=on
# Edit the command line with emacs or vi key bindings.
# (set -o emacs or set -o vi)
editor.base_mode=emacs

# Recall only history entries that begin with the typed text on Up and Down.
editor.history.arrow_keys_search_by_typed_prefix=on
# Store command history in this file. KOSH_HISTORY_FILE supplies the value.
# editor.history.file_path=
# Keep at most this many history entries. KOSH_HISTORY_SIZE supplies the value,
# and 0 keeps none.
editor.history.max_entries=4096
# Return a failed history substitution to the editor. (shopt histreedit)
editor.history.bash.reedit_failed_substitution=off
# Load an expanded history reference into the editor. The shell runs it after
# the user accepts it. (shopt histverify)
editor.history.bash.verify_expansion_before_running=off

# Set the diagnostic level from 0 to 3: 0 keeps the mood's default, and 1, 2,
# and 3 act as -W, -WW, and -WWW.
optimizer.warning_level=0
# Report the annoying diagnostic tier.
optimizer.show_annoying_tier=on
# Analyze each chunk before it runs.
optimizer.analyze_before_running=on
# Show the backtrace of sourced files and function calls below an error or
# warning.
optimizer.show_source_traces=on

# Let the bash and sh moods run a bundled koshkit utility by its plain name when
# PATH has no program of that name. The kosh mood always does, whatever this
# value.
interpreter.resolve_koshkit_applets_as_commands=off
# Use arbitrary-precision integers and finite decimal values.
interpreter.arithmetic_uses_big_numbers=on
# Mimic the shell selected by a script's shebang.
interpreter.mimic_shebang=off

# Print the AST before each command runs.
debug.print_syntax_tree=off
# Print the escape bitmap after each parse.
debug.print_lexed_word_escapes=off
# Show diagnostics for every non-zero exit code.
debug.report_nonzero_exit_codes=off
# Show diagnostics for every exit code, including a successful zero.
debug.report_every_exit_code=off
# Print evaluation statistics after each run.
debug.print_evaluation_statistics=off
# Print a detailed memory report at exit.
debug.print_memory_report_at_exit=off

# Source the startup files of each listed mood, comma separated, when the shell
# is interactive or a login shell. Empty selects the session mood.
# init_moods=

# Mark every assigned variable for the environment. (set -o allexport)
interpreter.posix.export_every_assigned_variable=off
# Exit on the first command that fails. (set -o errexit)
interpreter.posix.exit_on_command_failure=off
# Disable pathname expansion. (set -o noglob)
interpreter.posix.glob_disabled=off
# Treat an unset variable as an error. (set -o nounset)
interpreter.posix.unset_variable_is_error=on
# Refuse to overwrite an existing file through '>'. (set -o noclobber)
interpreter.posix.redirect_refuses_to_overwrite_files=off
# Report a pipeline's status as the rightmost stage that failed.
# (set -o pipefail)
interpreter.posix.pipeline_fails_on_any_stage=on

# Report a background job's completion immediately when it finishes.
# (set -o notify)
editor.posix.jobs_report_status_immediately=off
# Require repeated end-of-file input before an interactive shell exits.
# (set -o ignoreeof)
editor.posix.ctrl_d_does_not_exit=off

# Place assignment arguments anywhere in a command into its environment.
# (set -o keyword)
interpreter.bash.assignments_anywhere_in_command=off
# Enable brace expansion. (set -o braceexpand)
interpreter.bash.brace_expansion=on
# Let shell functions, command substitutions, and subshells inherit the ERR
# trap. (set -o errtrace)
interpreter.bash.trap_err_inherited_by_functions=off
# Resolve symbolic links while changing directories. (set -o physical)
interpreter.bash.cd_resolves_symlinks=off
# Let shell functions, command substitutions, and subshells inherit the DEBUG
# and RETURN traps. (set -o functrace)
interpreter.bash.trap_debug_and_return_inherited_by_functions=off
# Expand an array subscript once in assignments and arithmetic.
# (shopt assoc_expand_once)
interpreter.bash.array_subscripts_expand_once=off
# Treat a cd operand that is not a directory as a variable naming one.
# (shopt cdable_vars)
interpreter.bash.cd_to_variable_value=off
# Check that a remembered command path still exists before running it.
# (shopt checkhash)
interpreter.bash.verify_remembered_command_paths=off
# Let a glob match names that begin with a dot. (shopt dotglob)
interpreter.bash.glob_includes_dotfiles=off
# Keep a non-interactive shell running when exec cannot run its command.
# (shopt execfail)
interpreter.bash.exec_failure_keeps_shell=off
# Expand aliases in commands. (shopt expand_aliases)
interpreter.bash.aliases_expand=on
# Accept the extended patterns ?(), *(), +(), @(), and !(). (shopt extglob)
interpreter.bash.glob_extended_patterns=on
# Process $'...' and $"..." quoting inside a quoted ${...} expansion.
# (shopt extquote)
interpreter.bash.quote_dollar_strings_in_parameter_expansion=on
# Fail a command whose glob matches nothing. (shopt failglob)
interpreter.bash.glob_no_match_is_error=on
# Order bracket ranges in globs and patterns by byte value.
# (shopt globasciiranges)
interpreter.bash.glob_ranges_use_ascii_order=on
# Never let a glob match . or .. (shopt globskipdots)
interpreter.bash.glob_never_matches_dot_and_dotdot=on
# Let ** in a glob match directories at any depth. (shopt globstar)
interpreter.bash.glob_double_star_recurses=off
# Let a command substitution inherit set -e. (shopt inherit_errexit)
interpreter.bash.command_substitution_inherits_exit_on_failure=off
# Run the last stage of a pipeline in the current shell. (shopt lastpipe)
interpreter.bash.pipeline_last_stage_runs_in_shell=off
# Give a new local variable the value of the variable it shadows.
# (shopt localvar_inherit)
interpreter.bash.local_inherits_outer_value=off
# Keep a local variable unset by unset from exposing the outer one.
# (shopt localvar_unset)
interpreter.bash.local_unset_hides_outer=off
# Match globs without regard to case. (shopt nocaseglob)
interpreter.bash.glob_ignores_case=off
# Match case, [[, and pattern operators without regard to case.
# (shopt nocasematch)
interpreter.bash.match_ignores_case=off
# Remove a glob that matches nothing. With this option off, the unmatched glob
# remains unchanged. (shopt nullglob)
interpreter.bash.glob_no_match_expands_to_nothing=off
# Replace an unquoted & in ${name/pattern/string} with the match.
# (shopt patsub_replacement)
interpreter.bash.pattern_substitution_ampersand_is_match=on
# Report a shift count larger than the positional parameters.
# (shopt shift_verbose)
interpreter.bash.shift_reports_overflow=off
# Search PATH for a source operand without a slash. (shopt sourcepath)
interpreter.bash.source_searches_path=on
# Close a {name}> descriptor when its command finishes. (shopt varredir_close)
interpreter.bash.redirect_variable_fd_closed_after_command=off
# Let echo expand backslash escapes by default. (shopt xpg_echo)
interpreter.bash.echo_interprets_backslash_escapes=off

# Write input to standard error as it is read. (set -o verbose)
debug.posix.trace_input_lines=off
# Print each command after expansion before it runs. (set -o xtrace)
debug.posix.trace_expanded_commands=off

# Change to a directory typed as a command name. (shopt autocd)
editor.bash.cd_by_typing_directory_name=on
# Correct minor spelling errors in a cd operand. (shopt cdspell)
editor.bash.cd_fix_typos=off
# List running and stopped jobs before an interactive shell exits.
# (shopt checkjobs)
editor.bash.jobs_check_before_exit=off
# Update COLUMNS and LINES after each command from the terminal size.
# (shopt checkwinsize)
editor.bash.update_columns_and_lines=on
# Send SIGHUP to every job when an interactive login shell exits.
# (shopt huponexit)
editor.bash.jobs_hangup_on_exit=off
# Allow comments in interactive shell input. (set -o interactive-comments)
editor.bash.interactive_comments=on
# Warn when a checked mail file was read since the last check. (shopt mailwarn)
editor.bash.mail_warn_when_read=off
# Expand parameters and substitutions in prompt strings. (shopt promptvars)
editor.bash.prompt_expands_parameters=on

# Quote every shell metacharacter in a completed file name.
# (shopt complete_fullquote)
completion.bash.quote_all_special_characters=on
# Replace a directory name with its expansion during completion.
# (shopt direxpand)
completion.bash.expand_directory_names=off
# Correct a misspelled directory name during completion. (shopt dirspell)
completion.bash.fix_directory_typos=off
# Drop FIGNORE suffixes from completions even when that leaves none.
# (shopt force_fignore)
completion.bash.always_apply_fignore=on
# Complete host names after an @ in a word. (shopt hostcomplete)
completion.bash.hostnames_after_at=on
# Offer no command completion on an empty line. (shopt no_empty_cmd_completion)
completion.bash.skip_empty_line=off
# Use the completion specifications defined by complete. (shopt progcomp)
completion.bash.programmable=on
# Complete an alias with the specification of the command it expands to.
# (shopt progcomp_alias)
completion.bash.programmable_follows_aliases=off

# Enable the behavior Bash provides for debuggers. (shopt extdebug)
debug.bash.debugger_support=off

# Write error messages in the GNU file:line format. (shopt gnu_errfmt)
optimizer.bash.errors_use_gnu_format=off
