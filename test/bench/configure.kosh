#!/bin/bash
# A deterministic configure-style benchmark with inactive branches, loops,
# and arithmetic expressions. The hot passes scale with SCALE.

set -u

# The work multiplier. A larger value lengthens every loop.
SCALE=${SCALE:-40}

# these configuration values stay unchanged throughout the workload.
CONFIG_TRACE=0
CONFIG_PROFILE=0
CONFIG_PARANOID=0
CONFIG_DEBUG=0
CONFIG_RELEASE=1

CHECKS=0
SUM=0

# the dense pass combines inactive guards and arithmetic across
# SCALE * 200 iterations.
i=0
limit=$((SCALE * 200))
while [ "$i" -lt "$limit" ]; do
  # these branches stay inactive with the configuration above.
  if [ 0 -eq 1 ]; then SUM=$((SUM + 999)); fi
  if [ "$CONFIG_TRACE" -eq 1 ]; then SUM=$((SUM + 1)); fi
  if [ "$CONFIG_PROFILE" -eq 1 ]; then SUM=$((SUM + 2)); fi
  if [ "$CONFIG_PARANOID" -eq 1 ]; then SUM=$((SUM + 3)); fi
  if [ "$CONFIG_DEBUG" -eq 1 ]; then SUM=$((SUM + 4)); fi
  if false; then SUM=$((SUM + 5)); fi

  # these loop conditions prevent iterations.
  while false; do SUM=$((SUM + 6)); done
  until true; do SUM=$((SUM + 7)); done

  # the constant-false condition prevents iterations.
  # the initializer still assigns d=0.
  for ((d = 0; 0; d++)); do SUM=$((SUM + 8)); done

  # the false condition leaves SUM unchanged.
  if false; then SUM=$((SUM + 9)); fi

  # both assignments leave SUM unchanged.
  SUM=$((SUM + i * 0))
  SUM=$((SUM + i - i))

  # each live iteration adds nine to SUM and increments CHECKS and i.
  SUM=$((SUM + 2 * 3 + 4 - 1))
  CHECKS=$((CHECKS + 1))
  i=$((i + 1))
done

# CONFIG_DEBUG=0 keeps the second pass inactive.
if [ "$CONFIG_DEBUG" -eq 1 ]; then
  j=0
  while [ "$j" -lt "$limit" ]; do
    SUM=$((SUM + j))
    j=$((j + 1))
  done
fi

# the release path runs with two inactive guards in each iteration.
if [ "$CONFIG_RELEASE" -eq 1 ]; then
  k=0
  rlimit=$((SCALE * 100))
  while [ "$k" -lt "$rlimit" ]; do
    if [ 1 -eq 0 ]; then SUM=$((SUM + 100)); fi
    if [ "$CONFIG_TRACE" -ne 0 ]; then SUM=$((SUM + 200)); fi
    SUM=$((SUM + 8 / 2 - 3))
    CHECKS=$((CHECKS + 1))
    k=$((k + 1))
  done
fi

echo "checks=$CHECKS"
echo "sum=$SUM"
echo "release=$CONFIG_RELEASE trace=$CONFIG_TRACE"
